# ---------------------------------------------------------------
# .env.edge.example — Supabase Edge Function secrets (placeholders)
# ---------------------------------------------------------------
# NeoBuild injects real values at publish from Platform shared secrets / BYOK.
# Do not commit .env.edge with real keys. Run: npm run deploy:secrets
# ---------------------------------------------------------------

ADMIN_NOTIFY_EMAIL=admin@your-domain.com
AI_PROVIDER=openai
BRAND_NAME=Your App Name
GEMINI_API_KEY=your_gemini_api_key
NEOBUILD_API_URL=https://api.neobuild.dev
OPENAI_API_KEY=your_openai_api_key
OSM_API_KEY=your_osm_api_key
OSM_BASE_URL=your_osm_base_url
PROJECT_RUNTIME_TOKEN=your_project_runtime_token
PUBLIC_APP_URL=https://your-app.example.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=your_resend_from
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=your_supabase_url
